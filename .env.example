# ChatOps privilege wall — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# WALL_PYTHON_IMAGE_TAG=python:3.13-alpine@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# The edge: the part your chat platform calls
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname for the endpoint buttons point at. Must resolve to this
# server's public IP for the Let's Encrypt TLS-ALPN challenge. REQUIRED.
WALL_HOSTNAME=

# The path the endpoint answers on. Default: /act
# EDGE_PATH=/act

# THE ONLY FIELDS THAT REACH THE PRIVILEGED SIDE. Written as name=dotted.path,
# read out of the incoming JSON. Everything else in a request stops at the edge.
# Keep the list short: each entry is one more thing the worker has to be careful
# about, and a field that is not listed cannot be smuggled in by adding it to a
# request. The default matches Mattermost and Slack interactive messages.
# FORWARD_FIELDS=token=context.token,user_id=user_id,user_name=user_name

# How long a click waits for its answer before the edge says "taking longer than
# usual". The work still happens; only the message update is lost. Default: 25.
# RESULT_WAIT=25

# Caps. A request here is a handful of short strings, and an open endpoint with
# a stopped worker must not be able to fill the disk.
# MAX_BODY=8192
# MAX_QUEUE=100
# FIELD_MAX=128

# ──────────────────────────────────────────────────────────────────────────────
# The worker: the part that holds the privilege
# ──────────────────────────────────────────────────────────────────────────────

# WHO MAY ACT, by chat-platform user id, comma separated. EMPTY MEANS NOBODY,
# and the worker enforces that rather than skipping the check. Set it before you
# hand anybody a button, and check it again after anyone's account is rebuilt:
# a stale id here is indistinguishable from a hostile one, which is the point.
ALLOWED_USER_IDS=

# Containers the example restart action may restart, comma separated. Empty
# means none. This is the blast radius of a click, so keep it to what you meant.
ALLOWED_CONTAINERS=

# Where a result or a refusal is announced, so the only copy is not an HTTP
# reply this process cannot read back. Your chat platform's incoming webhook.
NOTIFY_URL=

# Where the button points. mint.py puts this into the message it prints.
# Normally https://${WALL_HOSTNAME}/act
ACTION_URL=

# ──────────────────────────────────────────────────────────────────────────────
# The canary (canary.sh)
# ──────────────────────────────────────────────────────────────────────────────

# Refusals from an id starting with this prefix are written to the log and never
# announced to NOTIFY_URL. canary.sh probes the endpoint by being refused twice,
# and both refusals are the check passing. Default: canary.
# CANARY_ID_PREFIX=canary

# The canary's second probe uses a LISTED id with a token nobody issued, to
# prove token validation is still reached. That means this id has to be in
# ALLOWED_USER_IDS above, next to the people. Write it so that nobody tidying
# the list later can read it and think it belongs to a colleague: in the system
# this pattern comes from, the canary's entry looked exactly like a person's,
# was deleted during a tidy-up of "stale" ids, and the health check broke that
# night.
#
#   ALLOWED_USER_IDS=<real ids>,canary1111111111111111
#
# CANARY_OUTSIDER_ID=canary0000000000000000
# CANARY_OPERATOR_ID=canary1111111111111111

# How long a minted button stays clickable. Default: 86400 (24h).
# TOKEN_TTL=86400

# How long an action may run before it is killed. Default: 120.
# ACTION_TIMEOUT=120

# How stale the worker's heartbeat may get before it is called unhealthy. It
# MUST exceed ACTION_TIMEOUT: the queue loop writes the heartbeat between
# requests, so one legitimate slow action holds it for as long as that action is
# allowed to run. Default: 180.
# HEARTBEAT_MAX_AGE=180

# ──────────────────────────────────────────────────────────────────────────────
# Resource limits (optional; the defaults are in the compose file)
# ──────────────────────────────────────────────────────────────────────────────
# EDGE_MEMORY_LIMIT=128m
# EDGE_CPU_LIMIT=0.5
# WORKER_MEMORY_LIMIT=256m
# WORKER_CPU_LIMIT=1.0
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested.
# TRAEFIK_IMAGE_VERSION=3.7
# WALL_PYTHON_IMAGE_VERSION=3.13-alpine
